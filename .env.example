# Copy this file to .env and fill in your keys. Never commit .env.

# VLM
OPENAI_API_KEY=sk-proj-...

# Weights & Biases
WANDB_API_KEY=...
WANDB_ENTITY=your-wandb-username-or-team
WANDB_PROJECT=RL_project

# Modal auth is handled via `modal token new` — no env var needed.
# Add OPENAI_API_KEY and WANDB_API_KEY as Modal Secrets in the dashboard.
# Secret name: semantic-per-secrets
