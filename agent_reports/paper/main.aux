\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces MetaWorld replay-mechanism ablation. Final success rate at $500$k env steps (mean across $n\!=\!5$ seeds; $95$\% bootstrap CI in brackets), and env-steps-to-first-$0.8$-success threshold (mean over seeds that reach the threshold; ``$n/5$'' is the number of seeds that reach it within $500$k steps). Lower steps-to-$0.8$ is better.}}{51}{table.11}\protected@file@percent }
\newlabel{tab:mw:results}{{11}{51}{MetaWorld replay-mechanism ablation. Final success rate at $500$k env steps (mean across $n\!=\!5$ seeds; $95$\% bootstrap CI in brackets), and env-steps-to-first-$0.8$-success threshold (mean over seeds that reach the threshold; ``$n/5$'' is the number of seeds that reach it within $500$k steps). Lower steps-to-$0.8$ is better}{table.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Final success rate at $500$k env steps on each MetaWorld task, grouped by replay-buffer variant. Bars are seed means; error bars are $\pm 1$ standard deviation across the $5$ seeds. Demo variants (green, red) saturate \texttt  {drawer-open-v3} and \texttt  {button-press-v3}. On \texttt  {sweep-into-v3} the demo variants help but do not saturate (per-seed: 2/5 succeed, 3/5 collapse). PER (orange) cleanly dominates uniform (blue) on all three tasks.}}{51}{figure.12}\protected@file@percent }
\newlabel{fig:mw:final}{{12}{51}{Final success rate at $500$k env steps on each MetaWorld task, grouped by replay-buffer variant. Bars are seed means; error bars are $\pm 1$ standard deviation across the $5$ seeds. Demo variants (green, red) saturate \texttt {drawer-open-v3} and \texttt {button-press-v3}. On \texttt {sweep-into-v3} the demo variants help but do not saturate (per-seed: 2/5 succeed, 3/5 collapse). PER (orange) cleanly dominates uniform (blue) on all three tasks}{figure.12}{}}
\citation{nair2018overcomingexploration}
\citation{vecerik2017ddpgfd,rajeswaran2017dapg}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Env-steps to first $0.8$ success-rate crossing on each MetaWorld task, by replay-buffer variant. Bars show the mean over seeds that reached $0.8$ within the $500$k step budget; the ``$n/5$'' annotation indicates how many seeds reached the threshold. Both demo variants reach $0.8$ in all five seeds on every task, including \texttt  {sweep-into-v3} where the policies later collapse---demos solve the first-touch exploration problem but not the stability problem on harder tasks.}}{52}{figure.13}\protected@file@percent }
\newlabel{fig:mw:stepsto08}{{13}{52}{Env-steps to first $0.8$ success-rate crossing on each MetaWorld task, by replay-buffer variant. Bars show the mean over seeds that reached $0.8$ within the $500$k step budget; the ``$n/5$'' annotation indicates how many seeds reached the threshold. Both demo variants reach $0.8$ in all five seeds on every task, including \texttt {sweep-into-v3} where the policies later collapse---demos solve the first-touch exploration problem but not the stability problem on harder tasks}{figure.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Evaluation success-rate curves over training, by replay variant and task. Solid line is the seed mean, shaded band is the $95$\% bootstrap CI across the $5$ seeds. The demo-replay and demo-priority curves are visually indistinguishable on every panel---they are in fact bit-identical (\S  \ref {app:mw:equiv}). PER consistently outruns uniform across all three tasks.}}{52}{figure.14}\protected@file@percent }
\newlabel{fig:mw:curves}{{14}{52}{Evaluation success-rate curves over training, by replay variant and task. Solid line is the seed mean, shaded band is the $95$\% bootstrap CI across the $5$ seeds. The demo-replay and demo-priority curves are visually indistinguishable on every panel---they are in fact bit-identical (\S \ref {app:mw:equiv}). PER consistently outruns uniform across all three tasks}{figure.14}{}}
