\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Non-uniform replay and off-policy correction methods. Top two rows (Retrace, V-trace) correct for \emph  {policy mismatch} in multi-step returns; bottom three rows (PER, VLM-RB, Sem.\ PER) are \emph  {replay-distribution} schemes over a fixed buffer. The shared IS-ratio form is the structural connection; the correction targets differ (see Appendix~\ref {app:vtrace}). Semantic PER (this paper) is the only replay scheme whose modifier is exogenous and trajectory-level.}}{8}{table.2}\protected@file@percent }
\newlabel{tab:taxonomy}{{2}{8}{Non-uniform replay and off-policy correction methods. Top two rows (Retrace, V-trace) correct for \emph {policy mismatch} in multi-step returns; bottom three rows (PER, VLM-RB, Sem.\ PER) are \emph {replay-distribution} schemes over a fixed buffer. The shared IS-ratio form is the structural connection; the correction targets differ (see Appendix~\ref {app:vtrace}). Semantic PER (this paper) is the only replay scheme whose modifier is exogenous and trajectory-level}{table.2}{}}
