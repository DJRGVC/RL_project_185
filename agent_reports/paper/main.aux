\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Final evaluation success rate across the three Fetch tasks (mean $\pm $ SE, $n\!=\!3$ seeds; individual seeds overlaid as dots).} \emph  {Methods are reported at heterogeneous training horizons} --- the italic gray stamp under each bar gives the training budget for that cell: Uniform and PER at 3M steps; HER at 250k steps; \emph  {vlm\_cf} and \emph  {verified\_cf} (ours) at 500k steps; Oracle-CF at 250k steps for FetchPush and FetchSlide and 1M steps for FetchPickAndPlace. \textbf  {Within-horizon comparisons (same stamp value) are statistically meaningful}; \textbf  {cross-horizon comparisons should be read as efficiency claims (more learning per training step) rather than asymptotic dominance.} The dashed gray line in each environment marks the HER baseline at 250k for visual reference. As a transparency note, an earlier pre-fix variant of this figure (Uniform/PER/Semantic-PER-Oracle/Semantic-PER-GPT-4o, 500k each) used a known-buggy all-variant prompt without the teleport gate that silently admitted $\sim $67\% degenerate counterfactuals as relabels; the corrected \emph  {vlm\_cf} and \emph  {verified\_cf} bars shown here replace those numbers (see Sections~\ref {sec:exp:prompt}--\ref {sec:exp:real} for the bug and fix).}}{14}{figure.6}\protected@file@percent }
\newlabel{fig:headline}{{6}{14}{\textbf {Final evaluation success rate across the three Fetch tasks (mean $\pm $ SE, $n\!=\!3$ seeds; individual seeds overlaid as dots).} \emph {Methods are reported at heterogeneous training horizons} --- the italic gray stamp under each bar gives the training budget for that cell: Uniform and PER at 3M steps; HER at 250k steps; \emph {vlm\_cf} and \emph {verified\_cf} (ours) at 500k steps; Oracle-CF at 250k steps for FetchPush and FetchSlide and 1M steps for FetchPickAndPlace. \textbf {Within-horizon comparisons (same stamp value) are statistically meaningful}; \textbf {cross-horizon comparisons should be read as efficiency claims (more learning per training step) rather than asymptotic dominance.} The dashed gray line in each environment marks the HER baseline at 250k for visual reference. As a transparency note, an earlier pre-fix variant of this figure (Uniform/PER/Semantic-PER-Oracle/Semantic-PER-GPT-4o, 500k each) used a known-buggy all-variant prompt without the teleport gate that silently admitted $\sim $67\% degenerate counterfactuals as relabels; the corrected \emph {vlm\_cf} and \emph {verified\_cf} bars shown here replace those numbers (see Sections~\ref {sec:exp:prompt}--\ref {sec:exp:real} for the bug and fix)}{figure.6}{}}
