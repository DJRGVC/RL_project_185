\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Prompt-variant analysis: mean~$\pm $~SE judge plausibility, goal-progress, and teleport-collapse rate (the fraction of \texttt  {corrective\_position} outputs landing within 5\,cm of \texttt  {desired\_goal}). Six bit-identical synthetic Fetch failures; the judge is Claude Opus 4.7 throughout. \textbf  {Bold}: best per column.}}{13}{table.3}\protected@file@percent }
\newlabel{tab:prompt-variants}{{3}{13}{Prompt-variant analysis: mean~$\pm $~SE judge plausibility, goal-progress, and teleport-collapse rate (the fraction of \texttt {corrective\_position} outputs landing within 5\,cm of \texttt {desired\_goal}). Six bit-identical synthetic Fetch failures; the judge is Claude Opus 4.7 throughout. \textbf {Bold}: best per column}{table.3}{}}
